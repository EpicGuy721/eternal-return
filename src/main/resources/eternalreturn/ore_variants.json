{
  "_comment": "Ore variants: every ore in every host stone (block eternalreturn:<host>_<ore>_ore). The game reads this at startup to register the blocks; tools/ores/build_ores.py reads it to write their models, textures, loot tables, recipes and tags. Adding an ore or a host is one entry here plus a rerun of the script. This mod's own ores (ruby, sapphire: tools/gems/build_gems.py makes their base blocks, run it first) name themselves as their deepslate version too, say which tool tier they need ('needs') and list other base blocks for their tags ('also'); 'keep' lists base ore files the clean-up must leave alone. An ore copies its vanilla block's behaviour; its overlay is a 16x16 image with transparency (path from the repository root), drawn over the host's texture. A host gives the block it replaces and its textures per face (all, or top/bottom/side).",
  "ores": {
    "coal": {"block": "minecraft:coal_ore", "deepslate": "minecraft:deepslate_coal_ore",
      "overlay": "tools/ores/overlays/coal.png"},
    "iron": {"block": "minecraft:iron_ore", "deepslate": "minecraft:deepslate_iron_ore",
      "overlay": "tools/ores/overlays/iron.png"},
    "copper": {"block": "minecraft:copper_ore", "deepslate": "minecraft:deepslate_copper_ore",
      "overlay": "tools/ores/overlays/copper.png"},
    "gold": {"block": "minecraft:gold_ore", "deepslate": "minecraft:deepslate_gold_ore",
      "overlay": "tools/ores/overlays/gold.png"},
    "redstone": {"block": "minecraft:redstone_ore", "deepslate": "minecraft:deepslate_redstone_ore",
      "overlay": "tools/ores/overlays/redstone.png"},
    "lapis": {"block": "minecraft:lapis_ore", "deepslate": "minecraft:deepslate_lapis_ore",
      "overlay": "tools/ores/overlays/lapis.png"},
    "diamond": {"block": "minecraft:diamond_ore", "deepslate": "minecraft:deepslate_diamond_ore",
      "overlay": "tools/ores/overlays/diamond.png"},
    "emerald": {"block": "minecraft:emerald_ore", "deepslate": "minecraft:deepslate_emerald_ore",
      "overlay": "tools/ores/overlays/emerald.png"},
    "ruby": {"block": "eternalreturn:ruby_ore", "deepslate": "eternalreturn:ruby_ore", "needs": "iron",
      "also": ["eternalreturn:nether_ruby_ore"], "overlay": "tools/ores/overlays/ruby.png"},
    "sapphire": {"block": "eternalreturn:sapphire_ore", "deepslate": "eternalreturn:sapphire_ore", "needs": "iron",
      "overlay": "tools/ores/overlays/sapphire.png"}
  },
  "keep": ["nether_ruby_ore"],
  "hosts": {
    "andesite": {"block": "minecraft:andesite", "textures": {"all": "minecraft:block/andesite"}},
    "diorite": {"block": "minecraft:diorite", "textures": {"all": "minecraft:block/diorite"}},
    "granite": {"block": "minecraft:granite", "textures": {"all": "minecraft:block/granite"}},
    "red_sandstone": {"block": "minecraft:red_sandstone", "textures": {"top": "minecraft:block/red_sandstone_top",
      "bottom": "minecraft:block/red_sandstone_bottom", "side": "minecraft:block/red_sandstone"}},
    "hardened_sandstone": {"block": "eternalreturn:hardened_sandstone", "textures": {"top": "minecraft:block/sandstone_top",
      "bottom": "minecraft:block/sandstone_bottom", "side": "minecraft:block/sandstone"}},
    "hardened_packed_ice": {"block": "eternalreturn:hardened_packed_ice", "textures": {"all": "minecraft:block/packed_ice"}}
  }
}
